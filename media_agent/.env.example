# Base media folder (or override individual folders below if on separate drives)
BASE_MEDIA_DIR=/mnt/media
# DOWNLOADS_DIR=/mnt/ssd/downloads
# VIDEOS_DIR=/mnt/hdd/videos
# SHOWS_DIR=/mnt/hdd/shows

# Path to tinyMediaManager CLI executable
TMM_BIN=/opt/tinyMediaManager/tinyMediaManager

# LM Studio API & loaded model ID
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=gemma-4-e2b

# OpenSubtitles.com credentials (only needed for movie subtitle scraping)
OPENSUBTITLES_USER=your_username
OPENSUBTITLES_PASS=your_password

# Optional Discord notification when manual review is needed
DISCORD_WEBHOOK_URL=