# Branding & Security
SITE_NAME=ReelVault
SITE_PIN=change_me
SITE_TIMEZONE=America/Los_Angeles

# Landing Page Background & Intro Videos (relative to web root)
# Leave LANDING_BG blank to auto-pick from media/background/, or point to a specific file
LANDING_BG=media/background/001.png

# Comma-separated intro videos, or leave blank to auto-scan media/*.mp4 (none = hidden)
LANDING_VIDEOS=

# Show/hide visitor & active profile counters on landing page
SHOW_STATS=true

# Optional subtitle / disclaimer text on landing page
FOOTER_NOTE=Create a profile name to keep track of your watch progress across devices.

# Captcha / Locked Folder toggles
REQUIRE_CAPTCHA=false
SHOW_LOCKED_FOLDER=false

# Library folders (leave SERIES_DIR blank to hide the Series section)
SERIES_DIR=
LOCAL_SHOWS_DIR=/mnt/media/shows

# Optional second machine (Slave PC) via Apache reverse proxy
REMOTE_ENABLED=false
REMOTE_API_PREFIX=/remote-api
REMOTE_SHOWS_DIR=/mnt/slave/shows

REMOTE_VIDEOS_DIR=/mnt/slave/videos
REMOTE_VIDEOS_PREFIX=/remote-videos

LOCAL_VIDEOS_DIR=/mnt/media/videos
REMOTE_HOST=
REMOTE_API_PORT=8080